{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "alm-pso-2026/motor-clinico-psoriasis",
    "type": "project",
    "description": "Motor de Pre-selección Clínica Etapa PO: MVP del motor de pre-screening clínico para psoriasis en placas.",
    "keywords": [
        "laravel",
        "psoriasis",
        "pre-screening",
        "ensayos-clinicos"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "aws/aws-sdk-php": "^3.300",
        "firebase/php-jwt": "^6.10",
        "guzzlehttp/guzzle": "^2.9",
        "laravel/framework": "^11.31",
        "laravel/passport": "^12.4",
        "laravel/tinker": "^2.9",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.17",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.3",
        "pestphp/pest": "^2.35",
        "pestphp/pest-plugin-laravel": "^2.4",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "pest",
        "test:coverage": "pest --coverage --min=80"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
